{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/exceptions.schema.json",
  "type": "object",
  "required": ["exceptions"],
  "properties": {
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "eventId", "date", "action"],
        "properties": {
          "id": { "type": "string" },
          "eventId": { "type": "string" },
          "date": { "type": "string" },
          "group": { "type": ["integer", "null"] },
          "action": {
            "enum": ["cancel", "move", "reschedule", "update", "replace"]
          },
          "newDate": { "type": ["string", "null"] },
          "day": { "type": ["string", "null"] },
          "start": { "type": ["string", "null"] },
          "end": { "type": ["string", "null"] },
          "location": {
            "type": ["object", "null"],
            "properties": {
              "building": { "type": ["string", "null"] },
              "floor": { "type": ["integer", "null"] },
              "room": { "type": ["string", "null"] }
            }
          },
          "replacementEventId": { "type": ["string", "null"] },
          "replacement": { "type": ["object", "null"] },
          "keepIdentity": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
